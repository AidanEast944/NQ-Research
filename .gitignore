venv/
src/__pycache__/
__pycache__/

# macOS
.DS_Store
**/.DS_Store

# Secrets - never commit real credentials, broker API keys, or account info.
# Added ahead of live-capital integration so nothing slips in by accident later.
.env
.env.*
*.key
*.pem
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
broker_config.json
**/broker_credentials*
**/*_credentials*


# Live/paper-trading runtime state - regenerated every run, not source, and changes
# constantly (would be pure commit noise). Back these up separately if ever needed.
data/*_state.json
data/*_account.json

# Operational run logs - noise, not research artifacts.
data/*_log.txt
data/*_errors.txt

# Generated visualizations - regenerate on demand via generate_dashboard.py /
# generate_morning_brief.py.
results/dashboard.html
results/equity_curve.png
results/combined_equity_curve.png
results/morning_brief.html

# One-off diagnostic scratch file, safe to delete.
data/_debug_combined_nq.csv
